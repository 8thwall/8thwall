{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@repo/*": [
        "../../*"
      ],
    },
  },
  "include": [
    ".",
    "../../reality/shared",
    "../../reality/cloud/xrhome/src/shared",
  ],
  "exclude": [
    "out",
    "node_modules",
    "dist"
  ],
}
